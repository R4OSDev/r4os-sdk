R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME={ProjectName}
VERSION={Version}
LANGUAGE=Rust
SOURCE=src/main.rs
ENTRY_MODE=app
APP_CLASS=gui
MODULE_ROLE=subsystem
SUBSYSTEM_ID=example.{ProjectNameLower}
SUBSYSTEM_DISPLAY_NAME={ProjectName}
GUEST_FORMAT=example.{ProjectNameLower}
GUEST_EXTENSION=example.{ProjectNameLower}:.xsub
TARGET=/R4OS/SUBSYSTEMS/example.{ProjectNameLower}/{ProjectName}.R4X
IMAGE_SCOPE=none
IMPORT=R4SYS:Query:1
IMPORT=R4DESK:Query:1
IMPORT=R4DRAW:Query:1
RESOURCE=NOTE:assets/note.txt
