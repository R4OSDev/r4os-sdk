const r4os=@import("r4os");
fn paint(window:*r4os.Window)i32 {
 var p=switch(window.beginPaint()){.paint=>|v|v,.failure=>|n|return n};
 _=p.canvas.clear(0x0024384c);_=p.canvas.text(16,20,"{ProjectName}",0xffffff,0x0024384c);return p.present();
}
fn work(app:*r4os.App)i32 {
 
 var timers:[1]r4os.Timer=.{.{}};
 var window=r4os.Window.init(app.system(),app.desktop() orelse return -1,app.drawing() orelse return -1,&timers) orelse return -2;
 _=window.setTitle("{ProjectName}");if(paint(&window)<0)return -3;
 while(!app.shouldClose())switch(window.waitMessage(r4os.time_contract.timeoutForever())){
  .message=>|m|switch(m){.close=>break,.resize=>{if(paint(&window)<0)return -4;},else=>{}},
  .failure=>|n|return n,else=>{},
 };
 return 0;
}

comptime {asm(r4os.r4x.entryAsm("raw_entry"));}
export fn raw_entry(raw:*const r4os.abi.R4XStartContext)callconv(.c)i32{
 var app=switch(r4os.App.init(raw,.desktop)){.value=>|v|v,.failure=>|e|return e.raw_code};return work(&app);
}
