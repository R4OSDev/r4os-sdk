#![no_std]
use r4os_sdk::{App, abi};

fn main(app: &mut App<'_>) -> i32 {
    let mut service=match app.register_service(){Ok(service)=>service,Err(_)=>return 2};
    let _=app.write("[RUST] {ProjectName}: service ready\n");
    while !app.should_close() {
        if service.wait(20).is_err() && !app.should_close(){return 3;}
        // Drain one bounded batch; an unread request keeps wait ready.
        let mut completed=0;
        while completed<abi::service_api_endpoint_queue_depth && !app.should_close() {
            let mut header=abi::ServiceMessageHeader::default();
            let mut payload=[0u8; abi::service_api_max_payload];
            let received=service.receive(&mut header,&mut payload);
            if received<0 {return 4;}
            // A zero-byte request is real when its header is valid.
            if received==0 && header.magic!=abi::service_api_magic {break;}
            let (status,response): (i32,&[u8])=if header.op==1 {
                (abi::service_api_result_ok,b"{ProjectName} OK")
            } else {
                (abi::service_api_result_bad_op,b"BADOP")
            };
            let replied=service.reply(header.request_id,status,response);
            // A caller may cancel after receive; only that exact absence is benign.
            if replied<0 && replied!=abi::service_api_result_not_found {return 5;}
            completed+=1;
        }
        if completed==abi::service_api_endpoint_queue_depth {app.sleep(1);}
    }
    if service.close().is_err(){return 6;}
    let _=app.write("[RUST] {ProjectName}: service stopped\n");
    0
}

r4os_sdk::app!(main);
