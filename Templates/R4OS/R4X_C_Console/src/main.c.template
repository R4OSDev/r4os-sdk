#include <r4os/app2.h>
#include <r4os/r4os.h>

R4OS_TEXT(hello_message, "HELLO from {ProjectName} via R4OS SDK");

static int32_t work(R4App *app)
{
    R4Console console = r4_app_console(app);
    return r4_console_line(&console, (const char *)hello_message);
}

int32_t r4_app_main(R4App2 *app2){
 R4App app;int32_t rc=r4_app2_facade(app2,&app);if(rc<0)return rc;return work(&app);
}
