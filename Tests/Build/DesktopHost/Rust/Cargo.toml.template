[package]
name="r4os-desktop-host-probe"
version="0.1.0"
edition="2024"
build=false
autobins=false
autoexamples=false
autotests=false
autobenches=false
[lib]
path="src/main.rs"
crate-type=["staticlib"]
[dependencies]
r4os-sdk={version="=0.1.0",features=["alloc"]}
r4os-r4std={path="{LibraryRoot}/R4STD/Bindings/Rust"}
r4os-r4img={path="{LibraryRoot}/R4IMG/Bindings/Rust"}
r4os-r4gfx={path="{LibraryRoot}/R4GFX/Bindings/Rust"}
[workspace]
